# ── PRISMA / POSTGRES ──────────────────────────────────────────
DATABASE_URL=
DIRECT_URL=

SUPABASE_SERVICE_ROLE_KEY=

# ── SUPABASE ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── PUSH (notificaciones web) ──────────────────────────────────
# Generar con: npx web-push generate-vapid-keys
# Sin estas 3 variables, src/lib/push.ts sale en silencio y ningún push
# llega nunca (ver enviarPush -> asegurarConfiguracion). Hay que setearlas
# tanto en local (.env) como en el entorno de producción (Vercel).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@blackhub.app

# ── IA (opcional) ───────────────────────────────────────────────
# Usado solo para sugerencias del coach y lectura de fotos de balanza.
# Sin esta key, esas funciones fallan de forma controlada con un mensaje.
ANTHROPIC_API_KEY=
